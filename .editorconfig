root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 80

[*.{md,py}]
indent_size = 4

[*.rs]
indent_size = 4
max_line_length = 100

[{justfile,*.just}]
indent_size = 4

[*.go]
indent_style = tab
max_line_length = off

[*.patch]
trim_trailing_whitespace = false
