# Never build with --cache-from/--cache-to: build-rootfs's RUN line stays the same when the
# repositories change. RUN lines are plain `sh -c`, no heredocs, for buildah older than 1.33.

ARG FEDORA=45
# Digest pins on registry.fedoraproject.org only (quay.io stops serving a digest a day
# after the tag moves), in the one-line form Renovate's regex managers need.
ARG BASE=registry.fedoraproject.org/fedora-bootc@sha256:5225b8afb65136bcf6131eb2b02ef7923a64e37264e5e0fdda47dfeef51851c1
# Bumped with BASE: the compose resolves against its repo files, GPG keys, $releasever.
ARG REPOS_BASE=registry.fedoraproject.org/fedora@sha256:1e13e11f63e147a40a935c9046c79d53a30b861a3cf05ebb023bb53c562382cb
ARG APEX_VERSION=
ARG APEX_REVISION=
ARG GA_REACHED=0
ARG FEDORA_GA_DATE=2026-11-03
ARG ALLOWLIST_GRACE_DAYS=7
ARG RELEASE_BUILD=0
ARG COMPOSE=build-rootfs
ARG LOCK=

# build-rootfs composes from this stage's root. rpm-ostree rewrites gpgkey=file:// paths into
# it but not baseurl=, so [apex] names its path inside the builder: /repos.
FROM ${REPOS_BASE} AS repos
ARG FEDORA
ARG GA_REACHED
ARG FEDORA_GA_DATE
ARG ALLOWLIST_GRACE_DAYS
COPY rpms/ /apex/
# libdnf reads a local repository's gpgkey= by file name from the repository itself.
COPY image/system_files/usr/share/apex/keys/RPM-GPG-KEY-apex /apex/RPM-GPG-KEY-apex
# libdnf keeps only a repository's last excludepkgs line, and admits all of it when its
# includepkgs matches nothing: apex-gnome51 must offer exactly the pinned builds.
RUN --mount=type=bind,source=image/packages,target=/run/apex-packages \
    set -eu; \
    rel=$(rpm -E %fedora); \
    if [ "$rel" != "${FEDORA}" ]; then echo "ERROR: REPOS_BASE is Fedora $rel, not ${FEDORA}" >&2; exit 1; fi; \
    arch=$(rpm -E %_arch); \
    apexkey=/apex/RPM-GPG-KEY-apex; fedorakey=/usr/share/pki/rpm-gpg/RPM-GPG-KEY-fedora-$rel-primary; \
    for k in "$apexkey" "$fedorakey"; do if [ ! -s "$k" ]; then echo "ERROR: $k is missing: [apex] verifies its packages with it" >&2; exit 1; fi; done; \
    cp "$fedorakey" /apex/; \
    reposfiles() { for f in /etc/yum.repos.d/*.repo /usr/share/dnf5/repos.d/*.repo; do if [ -f "$f" ]; then printf '%s\n' "$f"; fi; done; }; \
    list() { sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$@"; }; \
    list /run/apex-packages/updates-testing-allowlist.txt >/tmp/ut-list; \
    allow=$(paste -sd, /tmp/ut-list); \
    echo "updates-testing allowlist: ${allow:-<empty>}"; \
    now=$(date -u +%s); \
    deadline=$(( $(date -u -d "${FEDORA_GA_DATE}" +%s) + ALLOWLIST_GRACE_DAYS * 86400 )); \
    if [ -n "$allow" ] && [ "$now" -gt "$deadline" ]; then \
        echo "ERROR: Fedora ${FEDORA} GA (${FEDORA_GA_DATE}) + ${ALLOWLIST_GRACE_DAYS} days has passed but image/packages/updates-testing-allowlist.txt still has entries. Empty it and build with GA_REACHED=1 (or move FEDORA_GA_DATE if GA slipped)." >&2; \
        exit 1; \
    fi; \
    for f in $(reposfiles); do \
        sed -i -e '/^\[/h' -e '/^enabled[[:space:]]*=/{' -e 'x' -e '/^\[updates-testing/{' -e 'x' -e 's/.*/enabled=0/' -e 'b' -e '}' -e 'x' -e '}' "$f"; \
    done; \
    dnf5 -y --setopt=install_weak_deps=False --repo=fedora --repo=updates install createrepo_c; \
    if ! find /apex -name '*.rpm' | grep -q .; then echo "ERROR: rpms/ in the build context has no RPMs (the apex RPM is required)" >&2; exit 1; fi; \
    lock=/apex/rpms.lock; \
    if [ ! -f "$lock" ]; then echo "ERROR: rpms/ has no rpms.lock: image.sh context --lane-lock puts the rebuild lane's lock there" >&2; exit 1; fi; \
    if ! head -n 1 "$lock" | grep -q '^# apex rpms.lock 1:'; then echo "ERROR: rpms/rpms.lock is not an rpms.lock of format 1" >&2; exit 1; fi; \
    echo "Rebuild lane (rpms/rpms.lock):"; awk '$1 == "family" { print "  " $0 }' "$lock"; \
    awk '$1 == "family" { st[$2] = $3 } $1 == "rpm" { if (st[$2] != "built" && st[$2] != "held") { print "ERROR: rpms.lock: an rpm line of " $2 ", which is not built or held" > "/dev/stderr"; exit 1 } print $4, $5 }' "$lock" >/tmp/lock-rpms.raw; \
    sort -u /tmp/lock-rpms.raw >/tmp/lock-rpms; \
    cut -d' ' -f1 /tmp/lock-rpms | sort -u >/tmp/lock-names; \
    createrepo_c /apex; \
    dnf5 -q --repofrompath=apex-probe,/apex --repo=apex-probe repoquery --available --queryformat '%{name} %{release} %{name}-%{epoch}:%{version}-%{release}.%{arch}\n' >/tmp/apex-pkgs; \
    echo "Local Apex repository:"; sed 's/^/  /' /tmp/apex-pkgs; \
    if ! grep -q '^apex ' /tmp/apex-pkgs; then echo "ERROR: rpms/ does not contain the apex RPM" >&2; exit 1; fi; \
    cut -d' ' -f1,3 /tmp/apex-pkgs | sort -u >/tmp/apex-nevras; \
    awk 'NR == FNR { want[$1] = 1; next } $1 in want' /tmp/lock-names /tmp/apex-nevras >/tmp/lock-offered; \
    comm -23 /tmp/lock-rpms /tmp/lock-offered | sed 's/^/  < /' >/tmp/lock-diff; \
    comm -13 /tmp/lock-rpms /tmp/lock-offered | sed 's/^/  > /' >>/tmp/lock-diff; \
    if [ -s /tmp/lock-diff ]; then echo "ERROR: [apex] must offer exactly the NEVRAs rpms.lock names for its packages (< locked, > offered):" >&2; cat /tmp/lock-diff >&2; exit 1; fi; \
    if [ -s /tmp/lock-rpms ]; then echo "[apex] offers exactly the $(wc -l </tmp/lock-rpms) locked build(s)"; fi; \
    list /run/apex-packages/apex.txt >/tmp/apex-names.raw; \
    if ! grep -Fxq apex /tmp/apex-names.raw; then echo "ERROR: image/packages/apex.txt does not list apex" >&2; exit 1; fi; \
    sort -u /tmp/apex-names.raw /tmp/lock-names >/tmp/apex-names; \
    apexnames=$(paste -sd, /tmp/apex-names); \
    ignored=$(cut -d' ' -f1 /tmp/apex-pkgs | sort -u | while read -r n; do grep -Fxq "$n" /tmp/apex-names || printf ' %s' "$n"; done); \
    if [ -n "$ignored" ]; then echo "NOTE: rpms/ also has packages that are not in apex.txt or rpms.lock; [apex] does not admit them:$ignored"; fi; \
    cp /tmp/lock-names /tmp/fedora-excludes; \
    if grep -Eq '^libfprint [^ ]*\.apex[0-9]+' /tmp/apex-pkgs; then \
        echo libfprint >>/tmp/fedora-excludes; \
        echo "Apex libfprint present: Fedora's libfprint is excluded"; \
    else \
        echo "NOTE: no Apex libfprint in rpms/: Fedora's stock libfprint will be used (degraded=fingerprint)"; \
    fi; \
    excludes=$(sort -u /tmp/fedora-excludes | paste -sd, -); \
    if [ -n "$excludes" ]; then \
        for f in $(reposfiles); do sed -i -e "/^\[\(fedora\|updates\)\]\$/a excludepkgs=$excludes" "$f"; done; \
        echo "fedora and updates exclude: $excludes"; \
    fi; \
    printf '%s\n' '[apex]' 'name=Apex packages built by this pipeline (build context rpms/)' 'baseurl=file:///repos/apex' 'enabled=1' 'priority=1' "includepkgs=$apexnames" 'gpgcheck=1' "gpgkey=file:///repos$apexkey file:///repos/apex/${fedorakey##*/}" 'repo_gpgcheck=0' 'skip_if_unavailable=False' >/etc/yum.repos.d/apex.repo; \
    if [ "${GA_REACHED}" != 1 ] && [ -n "$allow" ]; then \
        vercmp() { rpm -E "%{lua: print(rpm.vercmp('$1', '$2'))}"; }; \
        if [ "$(vercmp 1:51~rc-2.fc45 1:51.0-1.fc45)" != -1 ] || [ "$(vercmp 51.0.1-1.fc45 51.0-1.fc45)" != 1 ]; then echo "ERROR: rpm.vercmp does not order versions as expected" >&2; exit 1; fi; \
        : >/tmp/ut-specs; \
        for s in $(printf '%s' "$allow" | tr ',' ' '); do \
            if ! printf '%s\n' "$s" | grep -Eqx "[A-Za-z0-9._+]+(-[A-Za-z0-9._+]+)*-[0-9][A-Za-z0-9._+~^]*-[0-9][A-Za-z0-9._+~^]*\.fc${FEDORA}[A-Za-z0-9._+~^]*"; then \
                echo "ERROR: updates-testing-allowlist.txt entry '$s' is not a pinned name-version-release (for example gtk4-4.24.0-1.fc${FEDORA})" >&2; exit 1; \
            fi; \
            printf '%s\n' "$s" >>/tmp/ut-specs; \
        done; \
        sort -u -o /tmp/ut-specs /tmp/ut-specs; \
        src=$(grep -l '^\[updates-testing\]$' $(reposfiles) | head -n 1); \
        if [ -z "$src" ]; then echo "ERROR: no [updates-testing] definition to derive apex-gnome51 from" >&2; exit 1; fi; \
        { printf '%s\n' '[apex-gnome51]' 'name=Fedora $releasever updates-testing, restricted to the pinned builds' 'enabled=1' 'skip_if_unavailable=False' "includepkgs=$allow"; \
          sed -n '/^\[updates-testing\]$/,/^\[/p' "$src" | sed -e '/^\[/d' -e '/^[[:space:]]*\(name\|enabled\|countme\|includepkgs\|excludepkgs\|skip_if_unavailable\)[[:space:]]*=/d'; \
        } >/etc/yum.repos.d/apex-gnome51.repo; \
        if ! dnf5 -q --repo=apex-gnome51 repoquery --available --arch="$arch,noarch" --queryformat '%{name} %{name}-%{version}-%{release}\n' >/tmp/ut-raw; then \
            echo "ERROR: cannot query apex-gnome51 (updates-testing); not guessing whether the pinned builds are still there" >&2; exit 1; \
        fi; \
        sort -u /tmp/ut-raw >/tmp/ut-avail; \
        extra=$(while read -r n nvr; do grep -Fxq "$nvr" /tmp/ut-specs || printf ' %s' "$nvr"; done </tmp/ut-avail); \
        if [ -n "$extra" ]; then echo "ERROR: includepkgs did not restrict apex-gnome51; it would admit:$extra" >&2; exit 1; fi; \
        cut -d' ' -f2 /tmp/ut-avail >/tmp/ut-known; \
        if ! dnf5 -q --repo=fedora --repo=updates --setopt=fedora.skip_if_unavailable=False --setopt=updates.skip_if_unavailable=False --setopt=fedora.excludepkgs= --setopt=updates.excludepkgs= repoquery --available --latest-limit=1 --arch="$arch,noarch" --queryformat '%{name} %{evr}\n' $(sed 's/-[^-]*-[^-]*$//' /tmp/ut-specs) >/tmp/ut-stable; then \
            echo "ERROR: cannot query the stable repositories (fedora, updates)" >&2; exit 1; \
        fi; \
        behind=""; instable=""; fromtesting=0; \
        while read -r s; do \
            n=${s%-*-*}; vr=${s#"$n"-}; \
            awk -v n="$n" '$1 == n { print $2 }' /tmp/ut-stable >/tmp/ut-one; \
            older=""; \
            if [ ! -s /tmp/ut-one ]; then older="not in fedora/updates"; fi; \
            while read -r evr; do \
                case $evr in *:*) e=${evr%%:*}; svr=${evr#*:} ;; *) e=0; svr=$evr ;; esac; \
                if ! printf '%s\n' "$e:$svr" | grep -Eqx '[0-9]+:[A-Za-z0-9._+~^]+-[A-Za-z0-9._+~^]+'; then echo "ERROR: unexpected version '$evr' of $n in the stable repodata" >&2; exit 1; fi; \
                c=$(vercmp "$e:$svr" "$e:$vr"); \
                case $c in 0 | 1) ;; -1) older="$svr < $vr" ;; *) echo "ERROR: rpm.vercmp printed '$c'" >&2; exit 1 ;; esac; \
            done </tmp/ut-one; \
            if [ -z "$older" ]; then instable="$instable $s"; \
            elif grep -Fxq "$s" /tmp/ut-known; then fromtesting=$((fromtesting + 1)); \
            else behind="$behind $n ($older)"; fi; \
        done </tmp/ut-specs; \
        if [ -n "$behind" ]; then \
            echo "ERROR: pinned builds are not in updates-testing, and the stable repositories carry them older or not at all:$behind. Fedora unpushed or replaced them, or they went stable and the stable repodata has not caught up; composing now would install the older builds. Retry later, or review image/packages/updates-testing-allowlist.txt." >&2; \
            exit 1; \
        fi; \
        if [ -n "$instable" ]; then echo "WARNING: fedora/updates carry these pinned builds at the same or newer versions; drop them from image/packages/updates-testing-allowlist.txt:$instable" >&2; fi; \
        if [ "$fromtesting" -gt 0 ]; then \
            echo "apex-gnome51 admits $(wc -l </tmp/ut-avail) pinned build(s) from updates-testing; fedora/updates lack $fromtesting of them"; \
            if [ -n "$excludes" ]; then printf '%s\n' "excludepkgs=$excludes" >>/etc/yum.repos.d/apex-gnome51.repo; echo "apex-gnome51 excludes: $excludes"; fi; \
        else \
            echo "fedora/updates carry every pinned build; dropping apex-gnome51"; \
            rm -f /etc/yum.repos.d/apex-gnome51.repo; \
        fi; \
    fi; \
    if ! dnf5 -q repo list --enabled >/tmp/repos-enabled; then echo "ERROR: dnf5 repo list failed" >&2; exit 1; fi; \
    if grep -Eq '^updates-testing' /tmp/repos-enabled; then echo "ERROR: updates-testing is still enabled" >&2; exit 1; fi; \
    echo "Enabled repositories:"; dnf5 repo list --enabled; \
    dnf5 clean all; \
    rm -rf /tmp/apex-pkgs /tmp/apex-names /tmp/apex-names.raw /tmp/apex-nevras /tmp/lock-rpms /tmp/lock-rpms.raw /tmp/lock-names /tmp/lock-offered /tmp/lock-diff /tmp/fedora-excludes /tmp/ut-list /tmp/ut-raw /tmp/ut-avail /tmp/ut-specs /tmp/ut-known /tmp/ut-stable /tmp/ut-one /tmp/repos-enabled /var/cache/libdnf5

# No --no-docs: the recovery runbook relies on the man pages.
FROM ${BASE} AS builder
# A new APEX_VERSION misses the layer cache, so a compose is never reused.
ARG APEX_VERSION
ARG LOCK
RUN --mount=type=bind,from=repos,src=/,dst=/repos,rw \
    --mount=type=bind,source=image/packages,target=/run/apex-packages \
    set -eu; \
    echo "Composing Apex ${APEX_VERSION:-development build}"; \
    list() { sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$@"; }; \
    set --; \
    for p in $(list /run/apex-packages/base.txt /run/apex-packages/gnome.txt /run/apex-packages/apex.txt); do set -- "$@" --install "$p"; done; \
    for p in $(list /run/apex-packages/exclude.txt); do set -- "$@" --exclude "$p"; done; \
    for n in ${LOCK:-}; do set -- "$@" --lock "$n"; done; \
    set -- "$@" --repo fedora --repo updates --repo apex; \
    if [ -f /repos/etc/yum.repos.d/apex-gnome51.repo ]; then set -- "$@" --repo apex-gnome51; fi; \
    /usr/libexec/bootc-base-imagectl build-rootfs --manifest=minimal "$@" /repos /target-rootfs

FROM scratch AS rootfs-build-rootfs
COPY --from=builder /target-rootfs/ /

# The fallback for when build-rootfs does not converge. Excludes do not reach into the base,
# so excluded packages are removed first; LOCK has no dnf5 equivalent.
FROM ${BASE} AS rootfs-dnf
RUN --mount=type=bind,from=repos,src=/,dst=/repos \
    --mount=type=bind,source=image/packages,target=/run/apex-packages \
    set -eu; \
    list() { sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$@"; }; \
    repos="--setopt=reposdir=/repos/etc/yum.repos.d,/repos/usr/share/dnf5/repos.d --repo=fedora --repo=updates --repo=apex"; \
    if [ -f /repos/etc/yum.repos.d/apex-gnome51.repo ]; then repos="$repos --repo=apex-gnome51"; fi; \
    guards="--setopt=install_weak_deps=False --setopt=excludepkgs=$(list /run/apex-packages/exclude.txt | paste -sd, -)"; \
    present=$(rpm -q --queryformat '%{NAME}\n' $(list /run/apex-packages/exclude.txt) | grep -v ' ' || true); \
    if [ -n "$present" ]; then echo "Removing excluded packages from the base:" $present; dnf5 -y $repos remove $present; fi; \
    dnf5 -y $repos $guards upgrade; \
    dnf5 -y $repos $guards install --allowerasing $(list /run/apex-packages/base.txt /run/apex-packages/gnome.txt /run/apex-packages/apex.txt); \
    dnf5 -y $repos clean all; \
    rm -rf /var/cache/libdnf5 /var/lib/dnf /var/log/dnf5.log* /tmp/* /var/tmp/*

# Build-context mounts sit directly under /run: bootc's nonempty-run-tmp lint skips
# mount points there.
FROM rootfs-${COMPOSE} AS final
ARG FEDORA
ARG BASE
ARG APEX_VERSION
ARG APEX_REVISION
ARG RELEASE_BUILD
COPY image/system_files/ /
# /run/systemd is a tmpfs: systemd-analyze verify writes there, which the nonempty-run-tmp
# lint rejects, and podman's resolv.conf mount blocks rm.
RUN --mount=type=bind,source=hardware/m7400qc/generated,target=/run/apex-hw \
    --mount=type=bind,source=image,target=/run/apex-image \
    --mount=type=bind,from=repos,src=/apex,target=/run/apex-rpms \
    --mount=type=tmpfs,target=/run/systemd \
    set -eu; \
    RELEASE_BUILD=${RELEASE_BUILD:-0}; \
    case "$RELEASE_BUILD" in 0|1) ;; *) echo "ERROR: RELEASE_BUILD must be 0 or 1" >&2; exit 1 ;; esac; \
    version=${APEX_VERSION:-}; \
    revision=${APEX_REVISION:-}; \
    if [ -z "$version" ] || [ -z "$revision" ]; then \
        if [ "$RELEASE_BUILD" = 1 ]; then echo "ERROR: APEX_VERSION and APEX_REVISION are required when RELEASE_BUILD=1" >&2; exit 1; fi; \
        version=${version:-${FEDORA}.$(date -u +%Y%m%d).0}; \
        revision=${revision:-0000000000000000000000000000000000000000}; \
        echo "WARNING: development build: version $version, revision $revision" >&2; \
    fi; \
    printf '%s\n' "$version" | grep -Eqx "${FEDORA}\.[0-9]{8}\.[0-9]+" || { echo "ERROR: APEX_VERSION '$version' is not ${FEDORA}.YYYYMMDD.N" >&2; exit 1; }; \
    printf '%s\n' "$revision" | grep -Eqx '[0-9a-f]{40}' || { echo "ERROR: APEX_REVISION '$revision' is not a 40-hex commit" >&2; exit 1; }; \
    degraded=/tmp/apex-degraded; : >"$degraded"; \
    install -D -m 0644 /run/apex-hw/monitors.xml /etc/xdg/monitors.xml; \
    fw=/run/apex-hw/alc294-m7400qc.fw; conf=/run/apex-hw/apex-audio.conf; \
    if [ -f "$fw" ] && [ -f "$conf" ]; then \
        grep -q 'apex/alc294-m7400qc\.fw' "$conf" || { echo "ERROR: apex-audio.conf must load patch=apex/alc294-m7400qc.fw (firmware is installed under /usr/lib/firmware/apex/)" >&2; exit 1; }; \
        install -D -m 0644 "$fw" /usr/lib/firmware/apex/alc294-m7400qc.fw; \
        install -D -m 0644 "$conf" /usr/lib/modprobe.d/apex-audio.conf; \
        echo "ALC294 patch firmware installed"; \
    elif [ -f "$fw" ] || [ -f "$conf" ]; then \
        echo "ERROR: hardware/m7400qc/generated has only one of alc294-m7400qc.fw and apex-audio.conf" >&2; exit 1; \
    else \
        echo "NOTE: audio not measured yet: no ALC294 patch firmware (degraded=audio)"; echo audio >>"$degraded"; \
    fi; \
    fprel=$(rpm -q --queryformat '%{RELEASE}' libfprint 2>/dev/null || true); \
    case "$fprel" in \
        *.apex[0-9]*) echo "libfprint release $fprel (Apex build)" ;; \
        *) echo "NOTE: libfprint is not the Apex build (${fprel:-not installed}): degraded=fingerprint"; echo fingerprint >>"$degraded" ;; \
    esac; \
    mkdir -p /usr/share/apex; \
    install -m 0644 /run/apex-rpms/rpms.lock /usr/share/apex/rpms.lock; \
    held=$(awk '$1 == "family" && $3 == "held" { print $2 }' /run/apex-rpms/rpms.lock); \
    for f in $held; do echo "NOTE: the $f family is held at its last good build (held=$f)"; done; \
    for f in $(awk '$1 == "family" && ($3 == "stock" || $3 == "degraded") { print $2 }' /run/apex-rpms/rpms.lock); do \
        case $f in \
            gnome-shell) echo "NOTE: the gnome-shell family is Fedora's build: degraded=shell"; echo shell >>"$degraded" ;; \
            *) echo "ERROR: the lane family $f is stock or degraded, but has no degraded name" >&2; exit 1 ;; \
        esac; \
    done; \
    sort -u "$degraded" >/tmp/apex-degraded.sorted; \
    rm -f /usr/lib/bootupd/updates/BIOS.json; \
    systemctl preset-all; \
    systemctl --user --global preset-all; \
    rm -f /usr/lib/systemd/system/default.target.wants/bootc-fetch-apply-updates.timer; \
    systemctl mask bootc-fetch-apply-updates.timer; \
    units="apex-boot-assess.service apex-update-auto.timer apex-flatpak-preinstall.service apex-flatpak-preinstall.timer apex-flatpak-update.timer bootloader-update.service chronyd.service gdm.service"; \
    systemctl enable $units; \
    systemctl set-default graphical.target; \
    for u in $units; do systemctl is-enabled --quiet "$u" || { echo "ERROR: $u is not enabled" >&2; exit 1; }; done; \
    [ "$(systemctl is-enabled bootc-fetch-apply-updates.timer 2>/dev/null || true)" = masked ] || { echo "ERROR: bootc-fetch-apply-updates.timer is not masked" >&2; exit 1; }; \
    [ "$(systemctl get-default)" = graphical.target ] || { echo "ERROR: default target is not graphical.target" >&2; exit 1; }; \
    for u in sshd.service sshd.socket; do if systemctl is-enabled --quiet "$u" 2>/dev/null; then echo "ERROR: $u is enabled; sshd must stay off outside the qualification VM (80-apex.preset)" >&2; exit 1; fi; done; \
    schemas=/usr/share/glib-2.0/schemas; tmp=$(mktemp -d); \
    cp "$schemas"/*.xml "$tmp"/; \
    for o in "$schemas"/*apex*.gschema.override; do if [ -f "$o" ]; then cp "$o" "$tmp"/; fi; done; \
    if ! glib-compile-schemas --strict --dry-run "$tmp"; then \
        rm -f "$tmp"/*apex*.gschema.override; \
        if glib-compile-schemas --strict --dry-run "$tmp"; then echo "ERROR: the Apex GSettings override is invalid (see above)" >&2; exit 1; fi; \
        echo "WARNING: installed upstream schemas fail --strict; the Apex override was not validated" >&2; \
    fi; \
    rm -rf "$tmp"; \
    glib-compile-schemas "$schemas"; \
    systemd-hwdb update --usr; \
    subpixel=/usr/share/fontconfig/conf.avail/10-sub-pixel-none.conf; \
    [ -f "$subpixel" ] || { echo "ERROR: $subpixel not found" >&2; exit 1; }; \
    ln -sfn "$subpixel" /etc/fonts/conf.d/10-sub-pixel-none.conf; \
    fc-cache --system-only; \
    set -- /usr/lib/modules/*; \
    if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then echo "ERROR: expected exactly one kernel in /usr/lib/modules, found: $*" >&2; exit 1; fi; \
    kver=${1##*/}; \
    DRACUT_NO_XATTR=1 dracut --no-hostonly --reproducible --early-microcode \
        --add 'crypt systemd-cryptsetup' \
        --add-drivers amdgpu --omit-drivers 'nouveau nova_core nova_drm snd_hda_intel' \
        -f "/usr/lib/modules/$kver/initramfs.img" "$kver"; \
    set --; \
    while IFS= read -r d; do if [ -n "$d" ]; then set -- "$@" --degraded "$d"; fi; done </tmp/apex-degraded.sorted; \
    for f in $held; do set -- "$@" --held "$f"; done; \
    apexctl build manifest --root / --version "$version" --revision "$revision" --base "$BASE" "$@"; \
    [ -s /usr/share/apex/manifest.json ] || { echo "ERROR: apexctl build manifest wrote no /usr/share/apex/manifest.json" >&2; exit 1; }; \
    python3 -c 'import json, sys; m = json.load(open("/usr/share/apex/manifest.json")); \
        want = {"schema": 1, "name": "apex", "fedora": int(sys.argv[1]), "version": sys.argv[2], \
            "revision": sys.argv[3], "base_image": sys.argv[4], \
            "degraded": sorted(open("/tmp/apex-degraded.sorted").read().split()), \
            "held": sorted(sys.argv[5].split())}; \
        bad = {k: m.get(k) for k, v in want.items() if m.get(k) != v}; \
        bad.update({} if m.get("packages") else {"packages": "missing or empty"}); \
        sys.exit("manifest.json mismatch: %r" % bad) if bad else \
            print("manifest.json OK: %d packages" % len(m["packages"]))' \
        "$FEDORA" "$version" "$revision" "$BASE" "$held"; \
    rc=0; \
    for c in /run/apex-image/checks/*.sh; do \
        echo "== ${c##*/}"; \
        ROOT=/ APEX_IMAGE_DIR=/run/apex-image RELEASE_BUILD="$RELEASE_BUILD" sh "$c" || rc=1; \
    done; \
    if [ "$rc" -ne 0 ]; then echo "ERROR: image checks failed (see FAIL lines above)" >&2; exit 1; fi; \
    : >/usr/lib/apex-build-lint-skips; \
    grep -v '^[[:space:]]*#' /run/apex-image/checks/lint-skips.txt | sed '/^[[:space:]]*$/d' >/tmp/lint-skips; \
    while IFS= read -r line; do \
        name=$(printf '%s\n' "$line" | cut -f1); \
        why=$(printf '%s\n' "$line" | cut -s -f2-); \
        if [ -z "$why" ] || [ "$name" = "$line" ]; then echo "ERROR: lint-skips.txt entry needs lint-name<TAB>justification: $line" >&2; exit 1; fi; \
        printf '%s\n' "$name" >>/usr/lib/apex-build-lint-skips; \
    done </tmp/lint-skips; \
    rm -rf /var/cache/* /var/log/* /var/lib/dnf /var/tmp/* /var/roothome/.cache /tmp/* /tmp/.[!.]*

# No mounts: the linter must see only what the container runtime puts in /run and /tmp.
RUN set -eu; \
    set --; \
    while IFS= read -r n; do if [ -n "$n" ]; then set -- "$@" --skip "$n"; fi; done </usr/lib/apex-build-lint-skips; \
    rm -f /usr/lib/apex-build-lint-skips; \
    bootc container lint --fatal-warnings "$@"

# image.sh labels the build with its version; the revision, created and apex.* labels come
# at rechunk time, over inherited ones.
LABEL containers.bootc="1" \
      ostree.bootable="1" \
      org.opencontainers.image.source="https://github.com/apex-linux/apex-image"
ENV container=oci
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
