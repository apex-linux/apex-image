#!/usr/bin/python3
"""The dnf5 calls of the Containerfile's repos stage, answered from FAKE_DNF_DIR:

  testing.txt   updates-testing: "name epoch version release arch" lines
  stable.txt    fedora + updates, same format
  fail-testing, fail-stable, fail-repolist, fail-apexprobe
                that query exits 1, as dnf5 does on a metadata error
  ignore-includes
                an includepkgs list is ignored, as libdnf does when it matches nothing
  log           every invocation, one line each
"""

import configparser
import glob
import os
import re
import sys

DIR = os.environ.get("FAKE_DNF_DIR", "/fakednf")


def log(argv):
    with open(os.path.join(DIR, "log"), "a", encoding="utf-8") as f:
        f.write(" ".join(argv) + "\n")


def flag(name):
    return os.path.exists(os.path.join(DIR, name))


def packages(name):
    path = os.path.join(DIR, name)
    out = []
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            for line in f:
                parts = line.split()
                if len(parts) == 5:
                    out.append(dict(zip(("name", "epoch", "version", "release", "arch"), parts)))
    return out


def repo_sections():
    cfg = configparser.RawConfigParser(strict=False, interpolation=None)
    files = sorted(glob.glob("/etc/yum.repos.d/*.repo") + glob.glob("/usr/share/dnf5/repos.d/*.repo"))
    for f in files:
        cfg.read(f)
    return cfg


def fmt(qf, pkg):
    qf = qf.replace("\\n", "\n")
    evr = "%s-%s" % (pkg["version"], pkg["release"])
    if pkg["epoch"] != "0":
        evr = "%s:%s" % (pkg["epoch"], evr)
    qf = qf.replace("%{evr}", evr)
    for key in ("name", "epoch", "version", "release", "arch"):
        qf = qf.replace("%%{%s}" % key, pkg[key])
    return qf


def matches(spec, pkg):
    nvr = "%s-%s-%s" % (pkg["name"], pkg["version"], pkg["release"])
    return spec in (pkg["name"], nvr)


def main(argv):
    log(argv)
    opts = [a for a in argv if a.startswith("-")]
    words = [a for a in argv if not a.startswith("-")]
    repos = [a.split("=", 1)[1] for a in opts if a.startswith("--repo=")]
    qf = next((a.split("=", 1)[1] for a in opts if a.startswith("--queryformat=")), None)
    if qf is None and "--queryformat" in argv:
        qf = argv[argv.index("--queryformat") + 1]
        words.remove(qf)
    arches = next((a.split("=", 1)[1].split(",") for a in opts if a.startswith("--arch=")), None)

    if words[:1] == ["install"] or words[:2] == ["clean", "all"]:
        return 0
    if words[:2] == ["repo", "list"]:
        if flag("fail-repolist"):
            print("Failed to load repositories", file=sys.stderr)
            return 1
        cfg = repo_sections()
        print("repo id        repo name")
        for section in cfg.sections():
            if cfg.get(section, "enabled", fallback="1").strip() in ("1", "true", "True"):
                print("%-14s %s" % (section, cfg.get(section, "name", fallback="")))
        return 0
    if words[:1] != ["repoquery"]:
        sys.exit("fake dnf5: unsupported call %r" % argv)
    names = words[1:]

    if any(a.startswith("--repofrompath=apex-probe,") for a in opts):
        if flag("fail-apexprobe"):
            return 1
        base = next(a for a in opts if a.startswith("--repofrompath=")).split(",", 1)[1]
        for path in sorted(glob.glob(os.path.join(base, "*.rpm"))):
            stem = os.path.basename(path)[: -len(".rpm")]
            nvr, _, arch = stem.rpartition(".")
            name, version, release = nvr.rsplit("-", 2)
            sys.stdout.write(fmt(qf, dict(name=name, epoch="0", version=version,
                                          release=release, arch=arch)))
        return 0

    if repos == ["apex-gnome51"]:
        if flag("fail-testing"):
            print("Failed to download metadata (metalink) for repository 'apex-gnome51'",
                  file=sys.stderr)
            return 1
        pkgs = packages("testing.txt")
        cfg = repo_sections()
        include = cfg.get("apex-gnome51", "includepkgs", fallback="")
        specs = [s for s in re.split(r"[,\s]+", include) if s]
        if specs:
            chosen = [p for p in pkgs if any(matches(s, p) for s in specs)]
            if chosen or not flag("ignore-includes"):
                pkgs = chosen
    elif sorted(repos) == ["fedora", "updates"]:
        if flag("fail-stable"):
            print("Failed to download metadata for repository 'fedora'", file=sys.stderr)
            return 1
        pkgs = packages("stable.txt")
    else:
        sys.exit("fake dnf5: unsupported repositories %r" % repos)

    if arches:
        pkgs = [p for p in pkgs if p["arch"] in arches]
    if names:
        pkgs = [p for p in pkgs if p["name"] in names]
    for p in pkgs:
        sys.stdout.write(fmt(qf or "%{name}-%{version}-%{release}.%{arch}\n", p))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
