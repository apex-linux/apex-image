{
  "default": [
    {
      "type": "reject"
    }
  ],
  "transports": {
    "docker": {
      "ghcr.io/sekirokenjii/apex": [
        {
          "type": "sigstoreSigned",
          "keyPaths": [
            "/usr/share/apex/keys/release.pub",
            "/usr/share/apex/keys/release-backup.pub"
          ],
          "signedIdentity": {
            "type": "matchRepository"
          }
        }
      ],
      "ghcr.io/sekirokenjii/apex-testing": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/usr/share/apex/keys/ci.pub",
          "signedIdentity": {
            "type": "matchRepository"
          }
        }
      ]
    }
  }
}
