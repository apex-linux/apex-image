# Override files apply in lexical order, so 90_ wins over Fedora's 00_ files.
# No color-scheme: the rebuilt gnome-shell draws GNOME's 'default' light.

[org.gnome.desktop.input-sources]
sources=[('xkb', 'us'), ('ibus', 'm17n:vi:telex')]
per-window=true

[org.gnome.shell]
# The shell hides the Bazaar Flatpak's entry until the preinstall has installed it.
favorite-apps=['org.gnome.Epiphany.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.TextEditor.desktop', 'io.github.kolunmi.Bazaar.desktop']

[org.gnome.settings-daemon.plugins.power]
# The fingerprint sensor is the power key: 'interactive' does nothing on the lock screen.
power-button-action='interactive'
