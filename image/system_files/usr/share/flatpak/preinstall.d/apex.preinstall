# Branch: flatpak assumes "master", Flathub publishes "stable". No CollectionID, as the
# Flathub remote has none: the app comes from the first remote that has it.

# The app store, instead of GNOME Software.
[Flatpak Preinstall io.github.kolunmi.Bazaar]
Branch=stable

[Flatpak Preinstall org.mozilla.firefox]
Branch=stable
