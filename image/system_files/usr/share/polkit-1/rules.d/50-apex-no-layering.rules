// rpmostreed authorizes uid 0 without polkit, so `sudo rpm-ostree` is not blocked here.
// ES5 only, for polkit's engine; action ids of rpm-ostree 2026.2's policy.

(function () {
    "use strict";

    var denied = [
        // bootc refuses to upgrade a deployment with local rpm-ostree modifications.
        "org.projectatomic.rpmostree1.install-uninstall-packages",
        "org.projectatomic.rpmostree1.install-local-packages",
        "org.projectatomic.rpmostree1.override",
        // These would bypass apex-updated's signature policy, denylist and boot counter.
        "org.projectatomic.rpmostree1.rebase",
        "org.projectatomic.rpmostree1.deploy",
        "org.projectatomic.rpmostree1.upgrade",
        "org.projectatomic.rpmostree1.rollback",
        "org.projectatomic.rpmostree1.finalize-deployment"
    ];

    polkit.addRule(function (action, subject) {
        if (denied.indexOf(action.id) < 0) {
            return polkit.Result.NOT_HANDLED;
        }
        polkit.log("apex: refusing " + action.id + " for " + subject.user +
                   ": rpm-ostree changes break bootc updates; use Flatpak, toolbox or apexctl");
        return polkit.Result.NO;
    });
}());
