# Replaces fedora-release-identity-basic's file, so rpm -V reports it modified.
# ID stays fedora: toolbox and container scanners key on it (toolbox ignores ID_LIKE).
# No REDHAT_* keys, so crash reporters never file Apex bugs with Fedora. The version
# fields change at each Fedora rebase. generic-logos also installs the LOGO icon.
NAME="Apex"
VERSION="45 (GNOME 51)"
ID=fedora
VERSION_ID=45
VERSION_CODENAME=""
PRETTY_NAME="Apex 45 (GNOME 51)"
LOGO=fedora-logo-icon
CPE_NAME="cpe:/o:fedoraproject:fedora:45"
DEFAULT_HOSTNAME="apex"
HOME_URL="https://github.com/SekiroKenjii/apex-fedora"
DOCUMENTATION_URL="https://github.com/SekiroKenjii/apex-fedora/tree/main/docs"
BUG_REPORT_URL="https://github.com/SekiroKenjii/apex-fedora/issues"
SUPPORT_END=2027-11-24
VARIANT="Apex"
VARIANT_ID=apex
