# The PCI core forbids runtime PM on every new device, and no driver binds the GA107 to
# allow it. "auto" lets the root port above it suspend, which cuts its power (D3cold).

ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{device}=="0x25a2", \
  TEST=="power/control", ATTR{power/control}="auto"
