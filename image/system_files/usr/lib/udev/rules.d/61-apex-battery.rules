# asus-nb-wmi adds BAT0's charge_control_end_threshold without a uevent: a "change" on BAT0
# reruns 60-upower-battery.rules. The trigger returns at once and cannot match this rule again.

ACTION=="bind", SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  TEST=="/sys/class/power_supply/BAT0", \
  RUN+="/usr/bin/udevadm trigger --action=change /sys/class/power_supply/BAT0"
