# The first matching line of all preset files wins, so 80- beats Fedora's 85- and 90-.
# The enable lines must match the Containerfile's explicit list (t-lists.sh checks it).

enable apex-boot-assess.service
enable apex-update-auto.timer

enable apex-flatpak-preinstall.service
enable apex-flatpak-preinstall.timer
enable apex-flatpak-update.timer

# Exactly one NTP client.
enable chronyd.service
disable systemd-timesyncd.service

# It runs `bootc upgrade --apply`, which reboots on its own; the Containerfile masks it.
disable bootc-fetch-apply-updates.timer

# Inert if a dependency ever brings greenboot back: apex-boot-assess replaces it.
disable greenboot-healthcheck.service
disable greenboot-set-rollback-trigger.service

# It rewrites shim and GRUB on the ESP, shared with Windows, outside the rollback
# envelope: bootc rollback cannot undo a bad write.
disable bootloader-update.service

# sshd is for the KVM qualification only, whose guest starts it with a kernel argument.
disable sshd.service
disable sshd.socket

# flatpak preinstall takes an app from the first remote that has it, and "fedora" sorts
# before flathub and also carries org.mozilla.firefox.
disable flatpak-add-fedora-repos.service
