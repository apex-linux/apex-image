# A first boot usually has no network until Wi-Fi is joined in Initial Setup, and then
# `flatpak preinstall` installs nothing and still exits 0. Time suspended does not count.

[Unit]
Description=Retry the Flatpak preinstall after boot

[Timer]
OnBootSec=5min
OnBootSec=15min
OnBootSec=30min
OnBootSec=1h
OnBootSec=2h
OnBootSec=4h
AccuracySec=1min

[Install]
WantedBy=timers.target
