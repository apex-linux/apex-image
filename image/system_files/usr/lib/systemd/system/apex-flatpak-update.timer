# Every 6 hours, not daily: systemd records a run before the service's conditions are
# checked, so one run skipped on battery or a metered network would use up the day.

[Unit]
Description=Update system Flatpak apps every 6 hours

[Timer]
OnCalendar=*-*-* 00/6:00:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
