[Unit]
Description=Update system Flatpak apps and runtimes
Documentation=man:flatpak-update(1) man:flatpak-preinstall(1)
Wants=network-online.target
After=network-online.target apex-flatpak-preinstall.service
ConditionACPower=true
ConditionPathExists=/usr/bin/flatpak

[Service]
Type=oneshot
# NetworkManager's Metered: 1 is yes, 3 guess-yes.
ExecCondition=/usr/bin/sh -c '\
    case "$$(/usr/bin/busctl get-property org.freedesktop.NetworkManager \
        /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered \
        2>/dev/null)" in \
    "u 1"|"u 3") exit 1 ;; \
    *) exit 0 ;; \
    esac'
# Catches up a first boot without network, and preinstall.d changes of an image update.
ExecStart=/usr/bin/flatpak preinstall --system --noninteractive
ExecStart=/usr/bin/flatpak update --system --noninteractive
ExecStart=/usr/bin/sh -c '\
    if [ ! -r /sys/module/nvidia/version ]; then echo "no NVIDIA driver loaded: no GL.nvidia extension"; exit 0; fi; \
    v=$$(/usr/bin/cat /sys/module/nvidia/version); \
    case "$$v" in ""|*[!0-9.]*) echo "/sys/module/nvidia/version reads $$v, not a driver version" >&2; exit 1 ;; esac; \
    want=org.freedesktop.Platform.GL.nvidia-$$(printf %%s "$$v" | /usr/bin/tr . -); \
    /usr/bin/flatpak install --system --noninteractive --or-update flathub "runtime/$$want/x86_64/1.4" || exit 1; \
    unit=apex-boot-assess.service; \
    state=$$(/usr/bin/systemctl show -p ActiveState -p Result -p ExecMainStatus "$$unit" | \
        /usr/bin/sort | /usr/bin/paste -s -d " " -); \
    id=$$(/usr/bin/systemctl show -p InvocationID --value "$$unit"); \
    decision=$$(/usr/bin/journalctl --boot "_SYSTEMD_INVOCATION_ID=$$id" --output=cat --no-pager --quiet | \
        /usr/bin/grep "decision: " | /usr/bin/tail -n 1); \
    case "$$state $$decision" in \
    "ActiveState=active ExecMainStatus=0 Result=success "*"(report green "* | \
    "ActiveState=active ExecMainStatus=0 Result=success "*"(report green)"*) ;; \
    *) echo "$$unit has not judged this boot green: stale GL.nvidia extensions stay"; exit 0 ;; \
    esac; \
    /usr/bin/flatpak list --system --runtime --columns=application | while read -r ext; do \
        case "$$ext" in "$$want") ;; org.freedesktop.Platform.GL.nvidia-*) \
            /usr/bin/flatpak uninstall --system --noninteractive "$$ext" || exit 1 ;; esac; \
    done'
# As root, flatpak 1.18 (flatpak_dir_list_unused_refs) does not see per-user apps and
# would remove the runtimes they use: skipped while any user has per-user Flatpaks.
ExecStart=/usr/bin/sh -c '\
    /usr/bin/getent passwd >/dev/null || exit 0; \
    if /usr/bin/getent passwd | while IFS=: read -r _ _ uid _ _ home _; do \
        [ "$$uid" -ge 1000 ] 2>/dev/null || continue; \
        for d in "$$home"/.local/share/flatpak/app/* "$$home"/.local/share/flatpak/runtime/*; do \
            if [ -e "$$d" ]; then \
                echo "$$home has per-user Flatpaks: unused system runtimes are kept"; \
                exit 1; \
            fi; \
        done; \
    done; then exec /usr/bin/flatpak uninstall --system --unused --noninteractive; fi'
TimeoutStartSec=2h
Nice=19
IOSchedulingClass=idle
