# The lane rehearsals' pair recipe (lane-rehearsal.sh), never the product's: the pair stays
# off until apex-kernel carries its own pkg.env. Used only through a scratch APEX_LANE_RECIPES.
source=copr-srpm
family=kernel-cachyos
install=kernel-cachyos kernel-cachyos-core kernel-cachyos-modules
kernel_env=kernel.env
nvidia_env=nvidia.env
