# image/Containerfile reads rpms/, image/ and hardware/m7400qc/generated/ from the build
# context: no pattern here may match them.
.git/
target/

# Work directories of .github/scripts and VM disk images, tens of GiB.
_build/
out/
**/*.qcow2
**/*.raw
**/*.iso

# A private key left in the tree must not reach the context: secrets.sh fails the image on it.
**/cosign.key
**/*.key

# Biometric captures, as in .gitignore, never reach an image even when left in the tree.
**/*.[Pp][Gg][Mm]
**/*.[Vv][Aa][Rr][Ii][Aa][Nn][Tt]
**/*.[Ii][Oo][Cc][Tt][Ll]
**/*.[Uu][Mm][Oo][Cc][Kk][Dd][Ee][Vv]
**/*.[Pp][Cc][Aa][Pp]
**/*.[Pp][Cc][Aa][Pp][Nn][Gg]
**/var/lib/fprint/

**/node_modules/
**/__pycache__/
