# KEY=VALUE lines, read by apex-lane and never sourced; the keys: packaging/README.md.

source=fedora-srpm
srpm=gnome-shell

on_fail=hold
family=gnome-shell

install=gnome-shell gnome-shell-common

# The shell runs on the exact mutter build it was built against, so the lock carries
# those Fedora-signed mutter binaries too.
pin=mutter
mirror=mutter mutter-common
mirror_dev=mutter-devkit

source1=desktop/shell
source1_paths=apex.gresource.xml js/ui/apex/ data/theme/apex/

# Keep in step with spec-edit's %prep lines: the lane checks that the tree is Fedora's
# plus the series, Source1 and exactly these changes.
prep_moved=data/theme/gnome-shell-light.css:data/theme/apex/stock/gnome-shell-light.css data/theme/gnome-shell-dark.css:data/theme/apex/stock/gnome-shell-dark.css
prep_deleted=data/theme/gnome-shell-high-contrast.css
