Name:           x
Release:        %{autorelease}.apex3.1
Source0:        x.tar.xz
Source1:        apex-shell-0123456789ab.tar
Patch:          fedora.patch
BuildRequires:  meson
BuildRequires:  mutter-devel >= %{mutter_version}
Requires:       mutter%{?_isa} >= %{mutter_version}
Requires:       mutter%{?_isa} = 51.0-1.fc45
%prep
%autosetup -S git -n x
tar -xkf %{SOURCE1}
mkdir data/stock
